# Copy this file to fabric.env if you want local overrides.
# The run script provides Org1 defaults for this repository.

FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=fabric-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST=peer0.org1.example.com
FABRIC_CHANNEL=trainingchannel
FABRIC_CHAINCODE=contracts
FABRIC_TIMEOUT=10s

# The HTTP API binds to localhost by default because authentication is not yet enabled.
FABRIC_ADAPTER_ADDRESS=127.0.0.1:8080
